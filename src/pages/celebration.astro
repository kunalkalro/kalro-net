---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Celebration — Sheridan & Kunal">
  <div class="shell-page">
    <div class="container">
      <h1 class="shell-title">The Celebration</h1>
      <p class="shell-body">Details about the three-day celebration coming soon.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .shell-page {
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .shell-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .shell-body {
    color: var(--color-ink-muted);
    font-size: 1rem;
  }
</style>
