---
// Replace YOUR_FORM_ID with your Formspree form ID after creating one at formspree.io
const FORMSPREE_ID = 'xkoyprya';
---

<section class="capture-section">
  <div class="container">
    <p class="capture-lead">
      Full details, travel info, and RSVP coming soon.<br />
      Leave your email to receive updates.
    </p>

    <form
      id="email-capture-form"
      class="capture-form"
      method="POST"
      action={`https://formspree.io/f/${FORMSPREE_ID}`}
      novalidate
    >
      <div class="form-row">
        <div class="form-field">
          <label for="name" class="form-label">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            class="form-input"
            placeholder="Your name"
            required
            autocomplete="name"
          />
        </div>
        <div class="form-field">
          <label for="email" class="form-label">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            class="form-input"
            placeholder="your@email.com"
            required
            autocomplete="email"
          />
        </div>
      </div>

      <button type="submit" class="form-submit">
        <span class="submit-text">Keep me posted</span>
        <span class="submit-loading" aria-hidden="true">Sending&hellip;</span>
      </button>

      <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<style>
  .capture-section {
    padding-block: var(--space-xl);
  }

  .capture-lead {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-muted);
    text-align: center;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .capture-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .form-input {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
    background-color: var(--color-jasmine);
    border: 1px solid color-mix(in srgb, var(--color-brass) 40%, transparent);
    border-radius: 4px;
    padding: 0.625rem 0.75rem;
    width: 100%;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input::placeholder {
    color: color-mix(in srgb, var(--color-ink-muted) 50%, transparent);
  }

  .form-input:focus {
    border-color: var(--color-marigold);
  }

  .form-submit {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-jasmine);
    background-color: var(--color-terracotta);
    border: none;
    border-radius: 4px;
    padding: 0.875rem var(--space-md);
    cursor: pointer;
    transition: background-color 0.2s, opacity 0.2s;
    position: relative;
    overflow: hidden;
    align-self: center;
    min-width: 180px;
  }

  .form-submit:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-terracotta) 85%, black);
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-loading {
    display: none;
  }

  .form-submit.loading .submit-text {
    display: none;
  }

  .form-submit.loading .submit-loading {
    display: inline;
  }

  .form-status {
    text-align: center;
    font-size: 0.9rem;
    min-height: 1.5em;
  }

  .form-status.success {
    color: #2D6A4F;
  }

  .form-status.error {
    color: var(--color-terracotta);
  }

  @media (max-width: 480px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('email-capture-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;
  const submitBtn = form?.querySelector('.form-submit') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      status.textContent = '';
      status.className = 'form-status';

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: data,
        });

        if (res.ok) {
          status.textContent = "You're on the list — we'll be in touch.";
          status.className = 'form-status success';
          form.reset();
        } else {
          const json = await res.json().catch(() => ({}));
          const msg = json?.errors?.map((err: { message: string }) => err.message).join(', ')
            ?? 'Something went wrong. Please try again.';
          status.textContent = msg;
          status.className = 'form-status error';
        }
      } catch {
        status.textContent = 'Could not submit. Check your connection and try again.';
        status.className = 'form-status error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
      }
    });
  }
</script>
